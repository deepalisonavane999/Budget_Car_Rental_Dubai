# ==============================================================================
# Budget UAE CRM - Environment Variables Template
# ==============================================================================
# COPY this file to .env.local for local development.
# For Vercel production, add these variables in your Vercel Project Settings > Environment Variables.
# NEVER commit your real .env or .env.local to this public repository.
# ==============================================================================

# Speed Auto Systems Azure API
# Secret keys are automatically injected server-side by proxies (Vite local proxy / Vercel Serverless Function)
SPEED_API_KEY=your_speed_auto_api_key_here
SPEED_API_CODE=your_azure_function_code_here
VITE_API_BASE_URL=

# CXPulse Ticketing API
CXPULSE_API_KEY=your_cxpulse_api_key_here
